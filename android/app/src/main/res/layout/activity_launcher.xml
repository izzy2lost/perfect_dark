<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#E8E8F0"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <!-- ROM -->

        <LinearLayout
            android:id="@+id/missingRomContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/infoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B9B9C6"
                android:textSize="15sp"
                android:text="@string/rom_missing"/>

            <Button
                android:id="@+id/pickRomButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/select_rom"/>
        </LinearLayout>

        <Button
            android:id="@+id/playButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/play"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Mods -->

        <TextView
            style="@style/PdSectionHeader"
            android:text="@string/mods"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8A8A99"
            android:textSize="13sp"
            android:text="@string/mods_hint"/>

        <RadioGroup
            android:id="@+id/modGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/importModButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/import_mod"/>

            <Button
                android:id="@+id/deleteModButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/delete_mod"/>
        </LinearLayout>

        <!-- On-screen controls -->

        <TextView
            style="@style/PdSectionHeader"
            android:text="@string/onscreen_controls"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8A8A99"
            android:textSize="13sp"
            android:text="@string/controls_hint"/>

        <TextView
            android:id="@+id/opacityLabel"
            style="@style/PdSliderLabel"
            android:text="@string/opacity"/>

        <SeekBar
            android:id="@+id/opacitySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"/>

        <TextView
            android:id="@+id/sensLabel"
            style="@style/PdSliderLabel"
            android:text="@string/look_sensitivity"/>

        <SeekBar
            android:id="@+id/sensSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"/>

        <Button
            android:id="@+id/resetLayoutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/reset_layout"/>

        <!-- Netplay -->

        <TextView
            style="@style/PdSectionHeader"
            android:text="@string/netplay"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textColor="#8A8A99"
            android:textSize="13sp"
            android:text="@string/netplay_hint"/>

    </LinearLayout>
</ScrollView>
