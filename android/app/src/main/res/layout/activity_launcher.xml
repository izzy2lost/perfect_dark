<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcherScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <!-- padding is applied in code so it can absorb the status bar, navigation bar and cutout -->
    <LinearLayout
        android:id="@+id/launcherContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="20dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/heroSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hero_subtitle"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorPrimary"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Play -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:minHeight="68dp"
            android:text="@string/play"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            app:cornerRadius="30dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="26dp"/>

        <!-- ROM -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/missingRomContainer"
            style="@style/PdCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/PdSectionHeader"
                    android:text="@string/rom"/>

                <TextView
                    android:id="@+id/infoText"
                    style="@style/PdBody"
                    android:text="@string/rom_missing"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pickRomButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/select_rom"
                    app:cornerRadius="22dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mods -->

        <com.google.android.material.card.MaterialCardView style="@style/PdCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/PdSectionHeader"
                    android:text="@string/mods"/>

                <TextView
                    style="@style/PdBody"
                    android:text="@string/mods_hint"/>

                <RadioGroup
                    android:id="@+id/modGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"/>

                <com.google.android.material.button.MaterialButtonGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/importModButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/import_mod"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/deleteModButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/delete_mod"/>
                </com.google.android.material.button.MaterialButtonGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- On-screen controls -->

        <com.google.android.material.card.MaterialCardView style="@style/PdCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/PdSectionHeader"
                    android:text="@string/onscreen_controls"/>

                <TextView
                    style="@style/PdBody"
                    android:text="@string/controls_hint"/>

                <TextView
                    android:id="@+id/opacityLabel"
                    style="@style/PdSliderLabel"
                    android:layout_marginTop="18dp"
                    android:text="@string/opacity"/>

                <com.google.android.material.slider.Slider
                    android:id="@+id/opacitySeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="0"
                    android:valueTo="100"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetLayoutButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/reset_layout"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Netplay -->

        <com.google.android.material.card.MaterialCardView style="@style/PdCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/PdSectionHeader"
                    android:text="@string/netplay"/>

                <TextView
                    style="@style/PdBody"
                    android:text="@string/netplay_hint"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
