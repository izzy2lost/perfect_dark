<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Base application theme. AppCompat reads the unprefixed windowActionBar/windowNoTitle
        attributes, not the android: ones, so the NoActionBar parent is what actually keeps the
        title bar away.
    -->
    <style name="Theme.PerfectDark" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- the app draws edge to edge and paints its own background behind the bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/pd_background</item>
    </style>

    <style name="Theme.PerfectDark.Fullscreen" parent="Theme.PerfectDark">
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="PdSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">#E8E8F0</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PdSliderLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">#B9B9C6</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
